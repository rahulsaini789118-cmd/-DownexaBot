# Telegram Bot Configuration
# Get this from @BotFather on Telegram
BOT_TOKEN=your_bot_token_here

# Your numeric Telegram user ID (get it from @userinfobot)
# This account will have access to the /admin panel
ADMIN_ID=123456789

# Optional: comma-separated list of additional admin IDs
EXTRA_ADMIN_IDS=

# Database
DATABASE_PATH=data/mediafetch.db

# Download settings
MAX_FILE_SIZE_MB=50
DOWNLOAD_TIMEOUT_SECONDS=120
MAX_CONCURRENT_DOWNLOADS=3
DOWNLOADS_DIR=downloads

# Rate limiting
RATE_LIMIT_MAX_REQUESTS=5
RATE_LIMIT_WINDOW_SECONDS=60

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/mediafetch.log
